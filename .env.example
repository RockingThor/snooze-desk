# GitHub Personal Access Token (fine-grained, read:notifications, write:issues)
GITHUB_TOKEN=your_github_token_here

# Ollama Configuration
OLLAMA_HOST=http://127.0.0.1:11434
# Gemma 4 E4B: default for classify. Digest defaults to gemma3:1b in the workflow.
# CLASSIFY_PROMPT=v1 uses the original prompt; default is v2.
OLLAMA_MODEL=gemma4:e4b
DIGEST_MODEL=gemma3:1b
CLASSIFY_PROMPT=v2

# Temporal Configuration
TEMPORAL_ADDRESS=localhost:7233

# Sentry Configuration (optional, for AI monitoring and tracing)
# Get a free DSN at sentry.io. Without a DSN, tracing is disabled.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Demo Mode (true to use fixtures, false to use real GitHub)
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
